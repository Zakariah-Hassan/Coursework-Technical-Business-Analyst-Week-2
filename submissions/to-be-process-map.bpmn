  <bpmn:collaboration id="Collaboration_0ozhctv">
    <bpmn:participant id="Participant_0gkhn4x" name="Account Delinquency As-is process" processRef="Process_1gmta2g" />
    <bpmn:group id="Group_0t5i61o" categoryValueRef="CategoryValue_12ys4z6" />
    <bpmn:group id="Group_0rd10z0" categoryValueRef="CategoryValue_12hnqct" />
    <bpmn:textAnnotation id="TextAnnotation_1bn7160">
      <bpmn:text>Reduced admin effort:  Removes routine balance enquiries, targeting the 12.49% of viewed accounts that have overdue balances</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1arwt4h">
      <bpmn:text>Reduced Admin Effort:      Removes routine contact resulting in promises to pay, targeting the 12.08% of sample account interactions</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_16stokt">
      <bpmn:text>Clearer Reporting:  Consistent data capture and labelling, improving aidit efficiency.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_008yn32">
      <bpmn:text>Clearer reporting:      Provides actionable insights into portal performance, operational efficiency, customer uptake, and abandonment. Enables data-driven decision-making and continuous improvement.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_16bbywr">
      <bpmn:text>Reduced Admin effort:       Representatives no longer need to present and describe payment plan options.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_11qbghr">
      <bpmn:text>Faster Next Action:        No longer requires back and forth communication between customer and representative</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_01fj8so">
      <bpmn:text>Reduced Admin Effort / faster Next Action:     Customers no longer have to repeat context &amp; representatives spend less time checking case status</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0jhsd89">
      <bpmn:text>Clearer Reporting:     Better organised data trail for portal interactions than representative interactions</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_076ni2q">
      <bpmn:text>Reduced Admin Effort:     Representative time no longer spent on as many automatable cases</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_17jl62u">
      <bpmn:text>Improved Follow-Up Consistency:     Well-tracked promises to pay make scheduling, tracking, and enforcing follow-ups easier.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1ytrrbg">
      <bpmn:text>Faster Next Action:    Automatable customers no longer have to wait for available representative. Fewer cases in the queue reduces wait time for all cases.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0gev9kd" associationDirection="None" sourceRef="Association_1pzz1zd" targetRef="TextAnnotation_076ni2q" />
    <bpmn:textAnnotation id="TextAnnotation_0bi0sc6">
      <bpmn:text>Reduced Admin Effort / faster Next Action:     Customers no longer have to repeat context &amp; representatives spend less time checking case status</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_03xwly0">
      <bpmn:text>Clearer Reporting:     Better organised data trail for portal interactions than representative interactions</bpmn:text>
    </bpmn:textAnnotation>
